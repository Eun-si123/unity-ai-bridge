{
  "name": "@unity-ai-bridge/mcp-server",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.19.0 <25"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && npm run test:built",
    "test:built": "node --test dist/tests/*.test.js",
    "test:local-bridge:built": "node --test dist/tests/local-bridge.test.js",
    "start": "node dist/src/index.js",
    "verify:unity": "npm run build && node dist/src/dev/verify-unity.js",
    "verify:mcp-unity": "npm run build && node dist/src/dev/verify-mcp-unity.js",
    "verify:reconnect": "npm run build && node dist/src/dev/verify-reconnect-unity.js",
    "verify:hierarchy": "npm run build && node dist/src/dev/verify-hierarchy-unity.js",
    "verify:create": "npm run build && node dist/src/dev/verify-gameobject-create-unity.js",
    "verify:diagnostics": "npm run build && node dist/src/dev/verify-diagnostics-unity.js",
    "verify:compiler-error": "npm run build && node dist/src/dev/verify-diagnostics-unity.js --require-compiler-error",
    "verify:resolver": "npm run build && node dist/src/dev/verify-object-resolver-unity.js",
    "verify:capabilities": "npm run build && node dist/src/dev/verify-agent-capabilities-unity.js",
    "verify:state-revision": "npm run build && node dist/src/dev/verify-state-revision-unity.js",
    "verify:mutation-status": "npm run build && node dist/src/dev/verify-mutation-status-unity.js",
    "verify:mutation-reconciliation": "npm run build && node dist/src/dev/verify-mutation-reconciliation-unity.js",
    "verify:action-undo": "npm run build && node dist/src/dev/verify-action-undo-unity.js",
    "verify:checkpoint-restore": "npm run build && node dist/src/dev/verify-checkpoint-restore-unity.js",
    "verify:task-resume": "npm run build && node dist/src/dev/verify-task-resume-unity.js",
    "verify:save": "npm run build && node dist/src/dev/verify-scene-save-unity.js",
    "verify:transform": "npm run build && node dist/src/dev/verify-transform-unity.js",
    "verify:gameobject-edit": "npm run build && node dist/src/dev/verify-gameobject-edit-unity.js",
    "verify:components": "npm run build && node dist/src/dev/verify-component-inspect-unity.js",
    "verify:component-mutations": "npm run build && node dist/src/dev/verify-component-mutation-unity.js",
    "verify:component-properties": "npm run build && node dist/src/dev/verify-component-property-unity.js",
    "verify:assets": "npm run build && node dist/src/dev/verify-asset-inspection-unity.js",
    "verify:script-read": "npm run build && node dist/src/dev/verify-script-read-unity.js",
    "verify:script-replace": "npm run build && node dist/src/dev/verify-script-replace-unity.js",
    "verify:play-mode": "npm run build && node dist/src/dev/verify-play-mode-unity.js",
    "verify:test-runner": "npm run build && node dist/src/dev/verify-test-runner-unity.js",
    "verify:playmode-tests": "npm run build && node dist/src/dev/verify-playmode-test-runner-unity.js",
    "verify:test-discovery": "npm run build && node dist/src/dev/verify-test-discovery-unity.js",
    "verify:prefab": "npm run build && node dist/src/dev/verify-prefab-unity.js",
    "verify:prefab-asset-create": "npm run build && node dist/src/dev/verify-prefab-asset-create-unity.js",
    "verify:prefab-property-apply": "npm run build && node dist/src/dev/verify-prefab-property-apply-unity.js"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "ws": "8.21.3"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@types/node": "24.13.3",
    "@types/ws": "8.18.1",
    "typescript": "7.0.2"
  }
}
